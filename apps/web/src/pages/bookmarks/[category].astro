---
import DirectoryShelves from '../../components/DirectoryShelves.astro';
import ResourcePage from '../../components/ResourcePage.astro';
import Layout from '../../layouts/Layout.astro';
import { SITE_NAME } from '../../lib/constants';
import {
  ACTIVE_DIRECTORY_CATEGORIES,
  DIRECTORY_PAGE_COPY,
} from '../../lib/directory';

export function getStaticPaths() {
  return ACTIVE_DIRECTORY_CATEGORIES.map((category) => ({
    params: { category: category.id },
    props: { category },
  }));
}

const { category } = Astro.props;
---

<Layout
  title={`${category.label} ${DIRECTORY_PAGE_COPY.title} - ${SITE_NAME}`}
  description={category.description}
>
  <ResourcePage
    activePage="shelf"
    title={DIRECTORY_PAGE_COPY.title}
    subtitle={DIRECTORY_PAGE_COPY.subtitle}
  >
    <DirectoryShelves activeId={category.id} />
  </ResourcePage>
</Layout>
