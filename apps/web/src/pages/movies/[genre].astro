---
import Layout from '../../layouts/Layout.astro';
import RatingShelves from '../../components/RatingShelves.astro';
import ResourcePage from '../../components/ResourcePage.astro';
import { SITE_NAME } from '../../lib/constants';
import {
  ACTIVE_MOVIE_CATEGORIES,
  getMovieCategoryPath,
  MOVIE_NAV_SHELVES,
  MOVIES_PAGE_COPY,
} from '../../lib/movies';

export function getStaticPaths() {
  return ACTIVE_MOVIE_CATEGORIES.map((category) => ({
    params: { genre: category.id },
    props: { category },
  }));
}

const { category } = Astro.props;
---

<Layout
  title={`${category.label} ${MOVIES_PAGE_COPY.title} - ${SITE_NAME}`}
  description={category.description}
>
  <ResourcePage
    activePage="shelf"
    title={MOVIES_PAGE_COPY.title}
    subtitle={MOVIES_PAGE_COPY.subtitle}
  >
    <RatingShelves
      copy={MOVIES_PAGE_COPY}
      navShelves={MOVIE_NAV_SHELVES}
      activeId={category.id}
      getPath={getMovieCategoryPath}
    />
  </ResourcePage>
</Layout>
