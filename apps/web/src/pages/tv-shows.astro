---
import Layout from '../layouts/Layout.astro';
import RatingShelves from '../components/RatingShelves.astro';
import ResourcePage from '../components/ResourcePage.astro';
import { SITE_NAME } from '../lib/constants';
import { RATING_ALL_CATEGORY_ID } from '../lib/ratings';
import {
  getTvShowCategoryPath,
  TV_SHOW_NAV_SHELVES,
  TV_SHOWS_PAGE_COPY,
} from '../lib/tvShows';
---

<Layout
  title={`${TV_SHOWS_PAGE_COPY.title} - ${SITE_NAME}`}
  description={TV_SHOWS_PAGE_COPY.searchDescription}
>
  <ResourcePage
    activePage="shelf"
    title={TV_SHOWS_PAGE_COPY.title}
    subtitle={TV_SHOWS_PAGE_COPY.subtitle}
  >
    <RatingShelves
      copy={TV_SHOWS_PAGE_COPY}
      navShelves={TV_SHOW_NAV_SHELVES}
      activeId={RATING_ALL_CATEGORY_ID}
      getPath={getTvShowCategoryPath}
    />
  </ResourcePage>
</Layout>
