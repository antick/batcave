---
import SearchBox from '../components/SearchBox';
import SiteFooter from '../components/SiteFooter.astro';
import SiteNav from '../components/SiteNav';
import Layout from '../layouts/Layout.astro';
import { SEARCH_PAGE_DESCRIPTION, SITE_NAME } from '../lib/constants';
import { getDynamicNavItems } from '../lib/navHelper';

const siteNavItems = await getDynamicNavItems();
---

<Layout title={`Search - ${SITE_NAME}`} description={SEARCH_PAGE_DESCRIPTION}>
  <div class="deck-scene">
    <SiteNav client:load siteNavItems={siteNavItems} />

    <main class="deck-wrapper">
      <div class="page-card-stack">
        <div class="page-card">
          <div class="card-content resource-page-card search-page-card">
            <div class="resource-page-header">
              <div class="card-heading">
                <h1 class="card-heading-title">Search</h1>
                <div class="card-accent-line"></div>
              </div>
              <p class="card-subtitle">
                Search across posts, projects, bookmarks, wishlist, movies, and
                About.
              </p>
            </div>

            <SearchBox client:load variant="page" autoFocus />
          </div>
        </div>
      </div>
    </main>
  </div>
  <SiteFooter />
</Layout>
