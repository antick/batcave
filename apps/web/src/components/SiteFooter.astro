---
import { FOOTER_CREDIT } from '../lib/constants';
import { FOOTER_LINKS } from '../lib/navigation';

const utilityLinks = [
  { href: '/rss.xml', label: 'RSS' },
  { href: '/sitemap.xml', label: 'Sitemap' },
];
const links = [...FOOTER_LINKS, ...utilityLinks];

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer-nav">
    {links.map((link) => (
      <a href={link.href} class="site-footer-link">
        {link.label}
      </a>
    ))}
  </div>
  <div class="site-footer-copy">
    &copy; {year} &nbsp;
    <a href={FOOTER_CREDIT.href} class="site-footer-link"
      >{FOOTER_CREDIT.label}</a
    >
  </div>
</footer>

<style>
.site-footer {
  width: calc(100% - 2 * var(--deck-side-padding));
  max-width: var(--deck-max-width);
  margin: 0 auto;
  padding: 16px 0 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  line-height: var(--font-line-height-ui);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  font-family: var(--font-body);
  color: var(--text-color);
  opacity: 0.72;
  box-sizing: border-box;
}

.site-footer-nav {
  display: flex;
  align-items: center;
  gap: 14px;
  flex-wrap: wrap;
}

.site-footer-link {
  color: inherit;
  text-decoration: none;
  background: none;
  box-shadow: none;
  padding: 0;
  border: none;
  border-radius: 0;
  display: inline;
  transition: color 0.2s ease;
}

.site-footer-link:hover {
  color: var(--accent-color);
  background: none;
  box-shadow: none;
}

.site-footer-link::after {
  display: none;
}

.site-footer-sep {
  opacity: 0.4;
}

.site-footer-copy {
  white-space: nowrap;
}

@media (max-width: 600px) {
  .site-footer {
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    padding: 14px 0 20px;
  }
}
</style>
